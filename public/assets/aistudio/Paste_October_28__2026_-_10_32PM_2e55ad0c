/* ========================================================
   2. UYGULAMA DURUMU (STATE) & VERİ YÖNETİMİ
   ======================================================== */
let S = {
  m: 0, th: '', rate: 1, fav: {}, w: {}, day: {},
  ob: 0, sel: [], dir: 1, goal: 20, fs: 1, rm: '',
  cw: [], u: { d: '', a: [] }, bk: 0, mem: {}
};
let W = [], view = 4, ob = {}, LIM = 400;

try {
  S = { ...S, ...JSON.parse(localStorage.getItem('kr2') || localStorage.getItem('kr') || '{}') };
} catch(e) {}

const save = () => { try { localStorage.setItem('kr2', JSON.stringify(S)); } catch(e){} };
const dk = (d = new Date()) => new Date(d - d.getTimezoneOffset() * 6e4).toISOString().slice(0, 10);
const norm = s => String(s || '').toLocaleLowerCase('tr');
const uc = () => S.u && S.u.d === dk() ? S.u.a.length : 0;
const inSel = g => !S.sel.length || S.sel.includes(g);
const DIRM = { 0:0, 1:0, 2:2, 3:2, 4:1, 5:1 };

let tm;
function toast(t) {
  const e = $('tt'); e.textContent = t; e.hidden = false;
  clearTimeout(tm); tm = setTimeout(() => e.hidden = true, 2400);
}

// Konfeti Kutlama Animasyonu
function launchConfetti() {
  const canvas = $('confetti'), ctx = canvas.getContext('2d');
  canvas.width = window.innerWidth; canvas.height = window.innerHeight;
  let pieces = Array.from({length: 60}, () => ({
    x: Math.random() * canvas.width, y: -10,
    size: Math.random() * 8 + 4,
    color: ['#16a34a', '#22c59b', '#f59e0b', '#3b82f6', '#ec4899'][Math.floor(Math.random()*5)],
    vx: (Math.random() - 0.5) * 4, vy: Math.random() * 4 + 2, rot: Math.random() * 360
  }));
  let frames = 0;
  function step() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    pieces.forEach(p => {
      p.x += p.vx; p.y += p.vy; p.rot += 3;
      ctx.fillStyle = p.color; ctx.fillRect(p.x, p.y, p.size, p.size);
    });
    if (++frames < 120) requestAnimationFrame(step);
    else ctx.clearRect(0, 0, canvas.width, canvas.height);
  }
  step();
}

// Leitner SRS & İlerleme Kaydı
function rec(id, ok) {
  try { navigator.vibrate && navigator.vibrate(ok ? 20 : [40, 60, 40]); } catch(e){}
  const w = S.w[id] || (S.w[id] = [0, 0]);
  if (ok) w[0] = Math.min(4, w[0] + 1);
  else { w[0] = 0; w[1]++; }
  const x = new Date(); x.setDate(x.getDate() + (ok ? [0, 1, 3, 7, 14][w[0]] : 0)); w[2] = dk(x);
  
  const d = S.day[dk()] || (S.day[dk()] = { n: 0, ok: 0 });
  d.n++; if (ok) d.ok++;
  if (S.u.d !== dk()) S.u = { d: dk(), a: [] };
  const nw = !S.u.a.includes(id);
  if (nw) S.u.a.push(id);
  
  save(); gprog();
  if (nw && S.u.a.length === (S.goal || 20)) {
    toast('🎯 Harika! Günlük çalışma hedefine ulaştın!');
    launchConfetti();
  }
}

const hard = id => { const w = S.w[id]; return !S.mem[id] && !!w && w[1] > 0 && w[0] < 3; };
function streak() {
  let n = 0; const d = new Date();
  for (let i = 0; i < 400; i++) {
    if (S.day[dk(d)] && S.day[dk(d)].n) n++;
    else if (i > 0) break;
    d.setDate(d.getDate() - 1);
  }
  return n;
}

function pick(P, not) {
  const ws = P.map(x => x === not ? 0 : (S.w[x.id] ? (5 - S.w[x.id][0]) * (S.w[x.id][2] > dk() ? 0.15 : 1) : 3));
  let r = Math.random() * ws.reduce((a, b) => a + b, 0);
  for (let i = 0; i < P.length; i++) {
    r -= ws[i]; if (r < 0) return P[i];
  }
  return P[0];
}

function pool(s, d) {
  const g = +$('qg').value, f = $('qf').value;
  return W.filter(w => (g < 0 ? inSel(w.g) : w.g === g) && w[s] && w[d] && (f === 'm' ? S.mem[w.id] : !S.mem[w.id] && (f === 'a' || (f === 'f' ? S.fav[w.id] : hard(w.id)))))
          .map(w => ({ id: w.id, p: w[s], a: w[d], g: w.gn, pr: w[s+'p'], ap: w[d+'p'] }));
}

// Sesli Okuma (Web Speech API)
function say(t, c) {
  try {
    const v = speechSynthesis.getVoices();
    const prefix = c.slice(0, 2);
    const u = new SpeechSynthesisUtterance(t);
    u.lang = c; u.rate = +S.rate || 1;
    speechSynthesis.cancel();
    speechSynthesis.speak(u);
  } catch(e) {
    toast('Sesli okuma bu cihazda desteklenmiyor');
  }
}

/* ========================================================
   3. REHBER LİSTESİ & DETAYLAR
   ======================================================== */
const V = w => ({ en: [w.en, w.enp], es: [w.es, w.esp], tr: [w.tr, ''] });

function row(w, cols, pr) {
  const v = V(w);
  return `<div class="it${S.mem[w.id] ? ' mm' : ''}" data-id="${esc(w.id)}" style="grid-template-columns:repeat(${cols.length}, 1fr) auto">` +
    cols.map(c => `<div>
      <span class="l">${L[c].s}</span>
      <b>${esc(v[c][0])} <button class="sp" aria-label="Sesli Oku" data-t="${esc(v[c][0])}" data-c="${L[c].c}">🔊</button></b>
      ${pr && v[c][1] ? `<i>${esc(v[c][1])}</i>` : ''}
    </div>`).join('') +
    `<div class="ac">
      <button class="sp st" aria-label="Ezberledim" data-m="${esc(w.id)}">${S.mem[w.id] ? '✅' : '⬜'}</button>
      <button class="sp st" aria-label="Favori" data-f="${esc(w.id)}">${S.fav[w.id] ? '⭐' : '☆'}</button>
    </div></div>`;
}

function render() {
  const cols = M[S.m], q = norm($('q').value.trim()), g = +$('grp').value, pr = $('pr').checked;
  let h = '', n = 0, last = -1;
  document.querySelectorAll('#modes button').forEach(b => b.classList.toggle('on', +b.dataset.i === S.m));

  W.forEach(w => {
    if (g >= 0 ? w.g !== g : (!q && !inSel(w.g))) return;
    if (q && ![w.en, w.enp, w.es, w.esp, w.tr].some(x => norm(x).includes(q))) return;
    if ($('hmem').checked && S.mem[w.id]) return;
    n++; if (n > LIM) return;
    if (w.g !== last) {
      h += `<div class="gt">${esc(w.gn)}</div>`;
      last = w.g;
    }
    h += row(w, cols, pr);
  });

  $('list').innerHTML = (h || '<p class="info" style="text-align:center;padding:24px 0">Sonuç bulunamadı.</p>') +
    (n > LIM ? `<button class="pr sec" id="more" style="width:100%;margin-top:10px">Daha Fazla Göster (${n - LIM})</button>` : '');
  $('info').textContent = `${n} kayıt listeleniyor · ✅ ${Object.keys(S.mem).length} ezberlenen`;
}

/* ========================================================
   4. FLAŞ KARTLAR (FLASHCARDS)
