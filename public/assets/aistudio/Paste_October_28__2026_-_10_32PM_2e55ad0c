let fcIndex = 0, fcPool = [];
function initFlashcards() {
  const g = +$('fcGroup').value;
  fcPool = W.filter(w => g < 0 ? inSel(w.g) : w.g === g);
  if (!fcPool.length) fcPool = W.slice(0, 20);
  fcIndex = 0;
  showFcCard();
}

function showFcCard() {
