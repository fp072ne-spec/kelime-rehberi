  transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  border-radius: var(--radius-lg); box-shadow: var(--sh-md); cursor: pointer;
}
.fc-card.flipped { transform: rotateY(180deg); }
.fc-face {
  position: absolute; inset: 0; backface-visibility: hidden; -webkit-backface-visibility: hidden;
  border-radius: var(--radius-lg); background: var(--card); border: 2px solid var(--bd);
  display: flex; flex-direction: column; justify-content: center; align-items: center;
  padding: 24px; text-align: center;
}
.fc-face.back {
  transform: rotateY(180deg); background: var(--card-sub); border-color: var(--ac);
}
.fc-title { font-size: 1.6rem; font-weight: 700; color: var(--tx); margin-bottom: 6px; word-break: break-word; }
.fc-sub { font-size: 0.95rem; color: var(--mut); }
.fc-hint { font-size: 0.75rem; color: var(--ac); font-weight: 600; margin-top: 14px; }

/* Quiz & Kartlar */
.qc {
  background: var(--card); border: 1px solid var(--bd); border-radius: var(--radius-lg);
  padding: 16px 18px; margin-top: 10px; box-shadow: var(--sh-md);
}
.chs { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0; }
.ch {
  border: 1.5px solid var(--bd); background: var(--card); color: var(--tx-sec);
  border-radius: 20px; padding: 8px 14px; font-size: 0.86rem; font-weight: 500;
  transition: all .16s ease;
}
.ch.big { padding: 14px 18px; font-size: 1rem; border-radius: 14px; width: 100%; text-align: left; }
.ch.on {
  border-color: var(--ac); background: var(--ac-soft); color: var(--ac); font-weight: 700;
}
.qw { font-size: 1.55rem; font-weight: 800; margin: 8px 0; color: var(--tx); word-break: break-word; }
.bx { display: flex; flex-wrap: wrap; gap: 5px; margin: 12px 0; }
.c {
  width: 32px; height: 42px; border: 1.8px solid var(--bd); border-radius: 8px;
  display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.15rem;
  background: var(--card-sub); color: var(--tx); transition: all .15s;
}
.bx.sm .c { width: 25px; height: 34px; font-size: 0.9rem; }
.c.ok { background: #16a34a; color: #fff; border-color: #16a34a; }
.c.yl { background: #d97706; color: #fff; border-color: #d97706; }
.c.no { background: #dc2626; color: #fff; border-color: #dc2626; }
.c.em { border: 1.8px dashed #dc2626; }
.c.cur { border-color: var(--ac); box-shadow: 0 0 0 2px var(--ac-soft); }
.sp0 { width: 12px; }
.pu { align-self: center; font-weight: 700; color: var(--mut); }
.fb { margin-top: 10px; font-size: 0.92rem; min-height: 24px; }
.sc { font-size: 0.85rem; color: var(--mut); display: flex; justify-content: space-between; font-weight: 600; }
.bt { display: flex; gap: 8px; margin-top: 12px; }
.bt button { flex: 1; }
.mc button {
  display: block; width: 100%; margin-top: 8px; text-align: left;
  padding: 13px 16px; border-radius: var(--radius-sm); border: 1.5px solid var(--bd);
  background: var(--card); color: var(--tx); font-size: 0.98rem; font-weight: 500;
  transition: all .18s;
}
.mc button:active { transform: scale(0.99); }
.mc button.good { background: #16a34a !important; color: #fff !important; border-color: #16a34a !important; }
.mc button.bad { background: #dc2626 !important; color: #fff !important; border-color: #dc2626 !important; }

.kb { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
.kk {
  border: 1px solid var(--bd); background: var(--card); color: var(--tx);
  border-radius: 8px; min-width: 38px; height: 38px; font-size: 1.05rem; font-weight: 600;
  box-shadow: var(--sh-sm);
}

/* Alt Gezinme Çubuğu (Bottom Navigation Bar) */
nav {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; background: color-mix(in srgb, var(--card) 92%, transparent);
  backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
  border-top: 1px solid var(--bd); padding-bottom: var(--safe-bottom);
  z-index: 30; box-shadow: 0 -4px 16px rgba(0,0,0,0.03);
}
nav button {
  flex: 1; border: 0; background: none; color: var(--mut);
  padding: 8px 0 6px; font-size: 0.72rem; font-weight: 500;
  display: flex; flex-direction: column; align-items: center; gap: 2px;
  transition: color .18s ease;
}
nav button span { font-size: 1.35rem; transition: transform .18s ease; }
nav button:active span { transform: scale(1.2); }
nav button.on { color: var(--ac); font-weight: 700; }
nav button.on span {
  background: var(--ac-soft); border-radius: 16px; padding: 2px 14px;
}

/* Modern Alt Çekmece (Detail Bottom Sheet) */
#sh {
  position: fixed; inset: 0; background: rgba(0,0,0,0.55);
  backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
  z-index: 40; display: flex; align-items: flex-end;
  animation: fadeIn .2s ease;
}
#sh[hidden], #ob[hidden] { display: none !important; }
.shc {
  background: var(--card); width: 100%; border-radius: 26px 26px 0 0;
  padding: 12px 20px calc(24px + var(--safe-bottom));
  animation: slideUp .28s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: var(--sh-lg); max-height: 85vh; overflow-y: auto;
}
.sheet-bar {
  width: 40px; height: 5px; border-radius: 4px; background: var(--bd);
  margin: 0 auto 14px; opacity: 0.8;
}
.shr {
  background: var(--card-sub); border: 1px solid var(--bd);
  border-radius: var(--radius-md); padding: 10px 14px; margin: 8px 0;
}
.shr .qw { font-size: 1.35rem; margin: 2px 0 0; }

/* Onboarding Modal */
#ob {
  position: fixed; inset: 0; background: var(--bg); z-index: 50;
  display: flex; align-items: center; justify-content: center;
  padding: calc(16px + var(--safe-top)) 16px calc(16px + var(--safe-bottom));
}
.obc {
  width: 100%; max-width: 440px; max-height: 100%;
  display: flex; flex-direction: column;
}
.obc h2 { font-size: 1.6rem; margin: 12px 0 4px; color: var(--ac); font-weight: 800; }
.obc p { color: var(--mut); margin: 0 0 14px; font-size: 0.92rem; }
.obb { overflow-y: auto; display: flex; flex-direction: column; gap: 8px; flex: 1; padding-right: 4px; }
.dots { display: flex; gap: 6px; }
.dots i { height: 5px; flex: 1; border-radius: 4px; background: var(--bd); transition: background .25s; }
.dots i.on { background: var(--ac); }

/* Toast Bildirimi & Konfeti Canvas */
#tt {
  position: fixed; left: 50%; bottom: calc(82px + var(--safe-bottom));
  transform: translateX(-50%); background: #121815f2; color: #fff;
  padding: 10px 18px; border-radius: 24px; font-size: 0.85rem; font-weight: 600;
  z-index: 60; box-shadow: 0 4px 16px rgba(0,0,0,0.25);
  animation: popIn .2s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex; align-items: center; gap: 6px; pointer-events: none;
}
#confetti {
  position: fixed; inset: 0; pointer-events: none; z-index: 99;
}

@keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes popIn { from { transform: translate(-50%, 15px); opacity: 0; } to { transform: translate(-50%, 0); opacity: 1; } }
</style>
</head>
