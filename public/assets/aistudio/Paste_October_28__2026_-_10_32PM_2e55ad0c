        <div style="font-size:1.2rem;font-weight:700">${t.n >= g ? 'Günlük Hedef Tamam! 🎉' : `Bugün ${g - t.n} kelime kaldı`}</div>
        <div class="hero-stats">
          <span>🔥 ${streak()} gün seri</span>
          <span>✅ ${kn} öğrenildi</span>
        </div>
      </div>
    </div>

    <div class="bt">
      <button class="pr" data-go="2">✍️ Quiz Başlat</button>
      <button class="pr sec" data-go="1">🃏 Kartlarla Çalış</button>
    </div>

    <div class="gt">✨ Günün Kelimesi / Cümlesi</div>
