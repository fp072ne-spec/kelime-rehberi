$('fcCard').onclick = () => $('fcCard').classList.toggle('flipped');
$('fcFlip').onclick = () => $('fcCard').classList.toggle('flipped');
$('fcNext').onclick = () => { if (fcIndex < fcPool.length - 1) { fcIndex++; showFcCard(); } };
$('fcPrev').onclick = () => { if (fcIndex > 0) { fcIndex--; showFcCard(); } };
$('fcSpeak').onclick = (e) => { e.stopPropagation(); say(fcPool[fcIndex].en, 'en-US'); };
$('fcGroup').onchange = initFlashcards;

/* ========================================================
   5. GELİŞMİŞ QUIZ SİSTEMİ
   ======================================================== */
const strip = s => s.replace(/\s*\([^)]*\)/g, '').trim();
const lo = (s, l) => l === 'tr' ? s.toLocaleLowerCase('tr') : s.toLowerCase();
const fold = (s, l) => lo(s, l).replace(/ı/g, 'i').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
const isL = c => /[\p{L}\p{N}]/u.test(c);

let Q = {}, alt = [];

function startQ(R) {
  const [s0, d] = QD[+$('qd').value], md = $('qm').value, s = md === 'dl' ? d : s0;
  const P = Array.isArray(R) ? R : pool(s, d);
  if (!P.length) { toast('Bu kategoride veya filtrede kelime yok'); return; }

  Q = {
    pool: P, cur: null, sc: 0, n: 0, tries: 0, done: false,
    src: s, dst: d, wrong: [], mode: md, max: +$('qn').value,
    cb: 0, wi: [], t0: Date.now(), tm: $('qt').checked
  };
  if (Array.isArray(R)) {
    Q.queue = [...P].sort(() => Math.random() - 0.5);
    Q.max = P.length;
  }
  $('qs').hidden = true; $('qp').hidden = false;
  $('kb').innerHTML = [...KC[d]].map(c => `<button type="button" class="kk" data-k="${c}">${c}</button>`).join('');
  nextQ();
}

function nextQ0() {
  const c = Q.queue && Q.queue.length ? Q.queue.shift() : pick(Q.pool, Q.cur);
  Q.cur = c; Q.tries = 0; Q.done = false;
  alt = [...new Set(Q.pool.filter(x => x.p === c.p).flatMap(x => strip(x.a).split(' / ').map(s => s.trim()).filter(Boolean)))];
  $('qw').textContent = c.p;
  $('qh').textContent = '📂 ' + c.g + (alt.length > 1 ? ' · (birden çok doğru cevap olabilir)' : '');
  $('ans').value = ''; $('ans').disabled = false; $('fb').textContent = '';
  $('chk').textContent = 'Kontrol Et'; $('skp').hidden = $('hnt').hidden = false;
  draw(null); upd(); $('ans').focus();
}

function nxt() {
  if (Q.max && Q.n >= Q.max) fin();
  else nextQ();
}

function nextQ1() {
  nextQ0();
  const mc = Q.em === 'mc';
  ['ans', 'bx', 'kb', 'chk', 'hnt', 'skp'].forEach(i => $(i).hidden = mc);
  $('mc').hidden = !mc;

  if (Q.mode === 'dl') {
    $('qw').textContent = '🔊 Dinle (Dokun: Tekrar et)';
    say(Q.cur.p, L[Q.dst].c);
  }
  if (mc) {
    const ds = [...new Set(Q.pool.map(x => strip(x.a).split(' / ')[0].trim()))].filter(a => !alt.includes(a)).sort(() => Math.random() - 0.5).slice(0, 3);
    const op = [alt[0], ...ds].sort(() => Math.random() - 0.5);
    $('mc').innerHTML = op.map(o => `<button data-o="${esc(o)}">${esc(o)}</button>`).join('');
    $('fb').textContent = '';
  }
}

$('qw').onclick = () => { if (Q.mode === 'dl' && Q.cur) say(Q.cur.p, L[Q.dst].c); };

$('mc').onclick = e => {
  const b = e.target.closest('[data-o]');
  if (!b || Q.done) return;
  Q.done = true; Q.n++;
  const ok = alt.includes(b.dataset.o);
  if (ok) {
    Q.sc++; qr(true); b.classList.add('good');
  } else {
    qr(false); Q.wrong.push(Q.cur.p + ' → ' + alt[0]); b.classList.add('bad');
    [...$('mc').children].forEach(x => { if (alt.includes(x.dataset.o)) x.classList.add('good'); });
  }
  upd(); setTimeout(nxt, ok ? 700 : 1600);
};

function qr(ok) {
  rec(Q.cur.id, ok);
  Q.cb = ok ? Q.cb + 1 : 0;
  if (ok && Q.cb >= 3) toast('🔥 ' + Q.cb + ' soru üst üste doğru!');
  if (!ok) Q.wi.push(Q.cur);
}

function nextQ() {
  Q.em = Q.mode === 'mix' ? (Math.random() < 0.5 ? 'mc' : 't') : Q.mode;
  nextQ1(); tmr(); upd();
}

function tmr() {
  clearInterval(Q.iv);
  const b = $('qtb'), f = b.firstElementChild;
  b.hidden = !Q.tm; if (!Q.tm) return;
  let l = 15; f.style.transition = 'none'; f.style.width = '100%';
  setTimeout(() => { f.style.transition = 'width 15s linear'; f.style.width = '0'; }, 30);
  Q.iv = setInterval(() => {
    if (Q.done) return clearInterval(Q.iv);
    if (--l <= 0) { clearInterval(Q.iv); timeUp(); }
  }, 1000);
}

function timeUp() {
  if (Q.done) return;
  toast('⏰ Süre doldu!');
  if (Q.em === 'mc') {
    Q.done = true; Q.n++; qr(false);
    Q.wrong.push(Q.cur.p + ' → ' + alt[0]);
    [...$('mc').children].forEach(x => { if (alt.includes(x.dataset.o)) x.classList.add('good'); });
    upd(); setTimeout(nxt, 1600);
  } else giveUp();
}

const upd = () => {
  $('qsc').textContent = `✅ ${Q.sc}/${Q.n}${Q.cb > 1 ? ' · 🔥 ' + Q.cb : ''}`;
  $('qinfo').textContent = Q.max ? `Soru ${Math.min(Q.n + (Q.done ? 0 : 1), Q.max)} / ${Q.max}` : `${Q.pool.length} kelime`;
  $('qpb').style.width = (Q.max ? (Q.n / Q.max * 100) : 0) + '%';
};

const typed = () => [...$('ans').value].filter(isL);

function grade(a) {
  const T = [...a].filter(isL), U = typed(), d = Q.dst;
  const st = T.map((c, i) => U[i] === undefined ? 'em' : lo(U[i], d) === lo(c, d) ? 'ok' : fold(U[i], d) === fold(c, d) ? 'yl' : 'no');
  const ex = Math.max(0, U.length - T.length);
  return { st, ex, good: st.filter(x => x === 'ok' || x === 'yl').length, all: st.every(x => x === 'ok' || x === 'yl') && !ex, exact: st.every(x => x === 'ok') && !ex };
}

function draw(res, a, show) {
  a = a || alt[0]; const U = typed(); let k = 0, h = '';
  for (const ch of a) {
    if (/\s/.test(ch)) h += '<span class="sp0"></span>';
    else if (!isL(ch)) h += `<span class="pu">${esc(ch)}</span>`;
    else {
      const u = U[k]; let cl = 'c', tx = u || '';
      if (show) tx = ch;
      else if (res) { cl += ' ' + res.st[k]; if (res.st[k] === 'em') tx = ''; }
      else if (k === U.length) cl += ' cur';
      h += `<div class="${cl}">${esc(tx)}</div>`; k++;
    }
  }
  if (res) for (let i = k; i < U.length; i++) h += `<div class="c no">${esc(U[i])}</div>`;
  $('bx').className = 'bx' + (k > 18 ? ' sm' : '');
  $('bx').innerHTML = h;
}

$('ans').oninput = () => { if (!Q.done) { $('fb').textContent = ''; draw(null); } };

function check() {
  if (Q.done) { nxt(); return; }
  if (!typed().length) { $('fb').textContent = 'Lütfen önce cevabını yaz 🙂'; return; }
  let best = null, ba = alt[0];
  alt.forEach(a => {
    const r = grade(a);
    if (!best || (r.all && !best.all) || (!best.all && (r.good - r.ex) > (best.good - best.ex))) {
      best = r; ba = a;
    }
  });
  draw(best, ba); const len = best.st.length;
  if (best.all) {
    Q.done = true; if (Q.tries === 0) { Q.sc++; qr(true); }
    Q.n++; upd(); $('ans').disabled = true; $('chk').textContent = 'Sonraki Soru →';
    $('skp').hidden = $('hnt').hidden = true;
    $('fb').innerHTML = best.exact ?
      '🎉 <b>Tebrikler, Doğru!</b>' + (alt.length > 1 ? ' (Diğer: ' + esc(alt.filter(x => x !== ba).join(', ')) + ')' : '') :
      '👍 <b>Doğru</b> — Aksan/harf farkı: <b>' + esc(ba) + '</b>';
  } else {
    if (Q.tries === 0) { qr(false); Q.wrong.push(Q.cur.p + ' → ' + alt[0]); }
    Q.tries++;
    $('fb').innerHTML = `🔎 <b>${best.good}/${len}</b> harf doğru${best.ex ? `, ${best.ex} fazla harf var` : ''}. Düzeltip tekrar dene!`;
  }
}

function hint() {
  if (Q.done) return;
  const a = alt[0], u = $('ans').value;
  let k = 0; while (k < u.length && k < a.length && lo(u[k], Q.dst) === lo(a[k], Q.dst)) k++;
  $('ans').value = a.slice(0, Math.min(a.length, k + 1));
  Q.tries++; draw(null); $('ans').focus();
}

function giveUp() {
  if (Q.done) return;
  Q.done = true; Q.n++;
  if (Q.tries === 0) { qr(false); Q.wrong.push(Q.cur.p + ' → ' + alt[0]); }
  upd(); $('ans').disabled = true; draw(null, alt[0], true);
  $('chk').textContent = 'Sonraki Soru →'; $('skp').hidden = $('hnt').hidden = true;
  $('fb').innerHTML = 'Doğru Cevap: <b>' + esc(alt.join(' / ')) + '</b>';
}

function fin() {
  clearInterval(Q.iv); $('qp').hidden = true; $('qs').hidden = false;
  if (!Q.n) { $('qr').innerHTML = ''; return; }
  const pc = Math.round(Q.sc / Q.n * 100);
  const sec = Math.round((Date.now() - Q.t0) / 1000);
  const st = pc >= 90 ? '⭐⭐⭐' : pc >= 70 ? '⭐⭐' : pc >= 40 ? '⭐' : '💪';
  const best = S.qb || 0;
  if (pc > best) { S.qb = pc; save(); }
  if (pc >= 80) launchConfetti();

  const wi = [...new Map(Q.wi.map(x => [x.id, x])).values()];
  Q.retry = wi;
  $('qr').innerHTML = `
    <div style="text-align:center;margin-bottom:14px">
      <div style="font-size:42px">${st}</div>
      <div class="qw" style="margin:2px 0">%${pc} Başarı</div>
      <div class="info">${Q.sc}/${Q.n} ilk denemede bildin · ${Math.floor(sec/60)} dk ${sec%60} sn${pc > best && best ? ' · 🏆 Yeni Rekor!' : ''}</div>
    </div>` +
    (wi.length ? `
      <div class="gt" style="margin-top:0">Tekrar Edilecek Yanlışlar (${wi.length})</div>
      ${wi.map(x => `<div class="it" style="grid-template-columns:1fr auto"><div><b>${esc(x.p)}</b><i>${esc(x.a)}</i></div><button class="sp" data-t="${esc(x.a)}" data-c="${L[Q.dst].c}" aria-label="Sesli Oku">🔊</button></div>`).join('')}
      <button class="pr" id="qre" style="margin-top:10px;width:100%">🔁 Sadece Yanlışları Tekrar Et</button>
    ` : '<p class="info" style="text-align:center">Mükemmel! Hiç yanlışın yok 🎉</p>');
}

$('qs').onclick = e => { if (e.target.id === 'qre') startQ(Q.retry); };

function chips(box, inp, at) {
  $(box).onclick = e => {
    const b = e.target.closest('[' + at + ']');
    if (!b) return;
    $(inp).value = b.getAttribute(at);
    [...$(box).children].forEach(x => x.classList.toggle('on', x === b));
  };
}
chips('qmc', 'qm', 'data-qm');
chips('qnc', 'qn', 'data-qn');

$('qgo').onclick = () => startQ();
$('chk').onclick = check;
$('skp').onclick = giveUp;
$('hnt').onclick = hint;
$('qx').onclick = fin;
$('ans').onkeydown = e => { if (e.key === 'Enter') check(); };
$('kb').onpointerdown = e => e.preventDefault();
$('kb').onclick = e => {
  const b = e.target.closest('[data-k]'); if (!b) return;
  const a = $('ans'); if (a.disabled) return;
  a.setRangeText(b.dataset.k, a.selectionStart, a.selectionEnd, 'end');
  a.dispatchEvent(new Event('input'));
};

/* ========================================================
   6. LİSTEM & İLERLEME RAPORU
   ======================================================== */
function mine() {
  const tp = D.map((g, i) => {
    if (!inSel(i)) return '';
    const k = W.filter(w => w.g === i && (S.mem[w.id] || (S.w[w.id] && S.w[w.id][0] >= 3))).length;
    return `<div class="tp">
      <span>${esc(g.n)}</span><b>${k}/${g.w.length}</b>
      <div class="lv"><i style="width:${k / g.w.length * 100}%"></i></div>
    </div>`;
  }).join('');

  const hd = W.filter(w => hard(w.id));
  const fv = W.filter(w => S.fav[w.id]);
  const kn = W.filter(w => S.mem[w.id] || (S.w[w.id] && S.w[w.id][0] >= 3)).length;
  const d = S.day[dk()] || { n: 0, ok: 0 };

  const sec = (t, a) => a.length ? `<div class="gt">${t} (${a.length})</div>` + a.slice(0, 50).map(w => row(w, ['en','es','tr'], false)).join('') : '';

  $('my').innerHTML = `
    <div class="stg">
