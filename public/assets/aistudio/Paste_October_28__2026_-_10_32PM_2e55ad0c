  var ICON_EYE_OFF = '<svg viewBox="0 0 24 24"><path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/><path d="M4 4l16 16"/></svg>';

  function $(s) { return document.querySelector(s); }
  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }
  function uid() { return Math.random().toString(36).slice(2, 10); }
  function str(x) { return typeof x === 'string' ? x : ''; }
  function num(x) { var n = Number(x); return isFinite(n) ? n : 0; }

  function parseAmount(s) {
    s = String(s == null ? '' : s).replace(/[₺\s]/g, '').replace(/tl/i, '');
    if (!s) return NaN;
    if (s.indexOf(',') >= 0) s = s.replace(/\./g, '').replace(',', '.');
    else if (/^\d{1,3}(\.\d{3})+$/.test(s)) s = s.replace(/\./g, '');
    if (!/^\d+(\.\d+)?$/.test(s)) return NaN;
    return Math.round(Number(s) * 100) / 100;
  }
  function toInput(n) { return String(n).replace('.', ','); }

  var nf = new Intl.NumberFormat('tr-TR', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
  var HIDE = false;
  try { HIDE = localStorage.getItem(LS_HIDE) === '1'; } catch (e) {}
  function money(n, sign) {
    if (HIDE) return '₺••••';
    var s = nf.format(Math.abs(n));
    return (n < 0 ? '−' : (sign && n > 0 ? '+' : '')) + '₺' + s;
  }

  function pad(n) { return String(n).padStart(2, '0'); }
  function isoDate(d) { return d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()); }
  function today() { return isoDate(new Date()); }
  function dateIn(days) { var d = new Date(); d.setDate(d.getDate() + days); return isoDate(d); }
  function dayDiff(iso) {
    var p = iso.split('-').map(Number);
    var a = new Date(p[0], p[1] - 1, p[2]);
    var t = new Date();
    var b = new Date(t.getFullYear(), t.getMonth(), t.getDate());
    return Math.round((a - b) / 864e5);
  }
  function fmtDate(iso) {
    var p = iso.split('-').map(Number);
    return new Date(p[0], p[1] - 1, p[2]).toLocaleDateString('tr-TR', { day: 'numeric', month: 'short', year: 'numeric' });
  }
  function fmtShort(ms) { return new Date(ms).toLocaleDateString('tr-TR', { day: 'numeric', month: 'short' }); }

  function defaultState() {
    return {
      v: 1, sample: false, updated: 0,
      accounts: [1, 2, 3].map(function (n) { return { id: 'a' + n, name: n + '. Borsa Hesabı', items: [] }; }),
      debts: []
    };
  }
  function normItem(i) {
    if (!i || typeof i !== 'object') return null;
    var kind = KINDS.some(function (k) { return k[0] === i.kind; }) ? i.kind : 'diger';
    var cost = num(i.cost);
    return { id: str(i.id) || uid(), name: str(i.name) || 'Adsız', kind: kind, amount: num(i.amount), cost: cost > 0 ? cost : null, note: str(i.note), at: num(i.at) || Date.now() };
  }
  function normDebt(d) {
    if (!d || typeof d !== 'object') return null;
    return {
      id: str(d.id) || uid(), person: str(d.person) || 'Adsız', dir: d.dir === 'verecek' ? 'verecek' : 'alacak',
      amount: num(d.amount), due: /^\d{4}-\d{2}-\d{2}$/.test(str(d.due)) ? d.due : null, note: str(d.note),
      created: num(d.created) || Date.now(),
      payments: (Array.isArray(d.payments) ? d.payments : []).map(function (p) {
        return p && typeof p === 'object' ? { id: str(p.id) || uid(), amount: num(p.amount), date: str(p.date) || today() } : null;
      }).filter(Boolean)
    };
  }
  function normalize(o) {
    var def = defaultState();
    if (!o || typeof o !== 'object') return def;
    var accs = Array.isArray(o.accounts) ? o.accounts : [];
    var out = { v: 1, sample: !!o.sample, updated: num(o.updated), accounts: [], debts: [] };
    for (var i = 0; i < 3; i++) {
      var a = accs[i] && typeof accs[i] === 'object' ? accs[i] : {};
      out.accounts.push({
        id: str(a.id) || def.accounts[i].id,
        name: str(a.name) || def.accounts[i].name,
        items: (Array.isArray(a.items) ? a.items : []).map(normItem).filter(Boolean)
      });
    }
    out.debts = (Array.isArray(o.debts) ? o.debts : []).map(normDebt).filter(Boolean);
    return out;
  }

  var S = defaultState();
  try {
    var raw = localStorage.getItem(LS_KEY);
    if (raw) S = normalize(JSON.parse(raw));
  } catch (e) {}

  function persistLocal() { try { localStorage.setItem(LS_KEY, JSON.stringify(S)); } catch (e) {} }

  function acct(id) { return S.accounts.filter(function (a) { return a.id === id; })[0]; }
  function itemSum(a) { return a.items.reduce(function (t, i) { return t + i.amount; }, 0); }
  function paidOf(d) { return d.payments.reduce(function (t, p) { return t + p.amount; }, 0); }
  function remaining(d) { return Math.max(0, Math.round((d.amount - paidOf(d)) * 100) / 100); }
  function plOf(a) {
    var pl = 0, cost = 0, any = false;
    a.items.forEach(function (i) { if (i.cost > 0) { any = true; pl += i.amount - i.cost; cost += i.cost; } });
    return any ? { pl: pl, cost: cost } : null;
  }
  function totals() {
    var invest = 0, rec = 0, pay = 0;
    S.accounts.forEach(function (a) { invest += itemSum(a); });
    S.debts.forEach(function (d) { if (d.dir === 'alacak') rec += remaining(d); else pay += remaining(d); });
    return { invest: invest, rec: rec, pay: pay, net: invest + rec - pay };
  }
  function kindLabel(k) { return (KINDS.filter(function (x) { return x[0] === k; })[0] || KINDS[3])[1]; }
  function plText(pl, cost) {
    if (HIDE) return money(pl, true);
    return money(pl, true) + ' · ' + (pl >= 0 ? '+' : '−') + '%' + Math.abs(pl / cost * 100).toFixed(1).replace('.', ',');
  }

  function touch() {
    S.updated = Math.max(Date.now(), (S.updated || 0) + 1);
    persistLocal();
    render();
  }

  var tab = (TABS.filter(function (t) { return t[0] === location.hash.slice(1); })[0] || TABS[0])[0];
  var debtFilter = 'acik';

  function setTab(name) {
    tab = name;
    try { location.hash = name; } catch (e) {}
    render();
  }

  function heroHtml() {
    var t = totals();
    return '<section class="hero">' +
      '<p class="eyebrow">Net Varlık</p>' +
      '<p class="net amt' + (t.net < 0 && !HIDE ? ' neg-total' : '') + '">' + money(t.net) + '</p>' +
      '<dl class="parts">' +
      '<div><dt>Yatırımlar</dt><dd>' + money(t.invest) + '</dd></div>' +
      '<div><dt>Alacaklar</dt><dd class="pos">' + money(t.rec) + '</dd></div>' +
      '<div><dt>Verecekler</dt><dd class="neg">' + money(t.pay) + '</dd></div>' +
      '</dl></section>';
  }

  function itemRow(a, i) {
    var pl = i.cost > 0 ? i.amount - i.cost : null;
    return '<button class="row" data-act="edit-item" data-a="' + a.id + '" data-i="' + i.id + '">' +
      '<span class="row-main"><span class="row-name">' + esc(i.name) + '</span>' +
      '<span class="row-meta"><span class="chip">' + kindLabel(i.kind) + '</span><span>' + fmtShort(i.at) + '</span>' +
      (i.note ? '<span class="note">· ' + esc(i.note) + '</span>' : '') + '</span></span>' +
      '<span class="row-val"><span class="amt">' + money(i.amount) + '</span>' +
      (pl !== null ? '<span class="sub ' + (pl >= 0 ? 'pos' : 'neg') + '">' + plText(pl, i.cost) + '</span>' : '') +
      '</span></button>';
  }

  function accountCard(a, idx) {
    var pl = plOf(a);
    var rows = a.items.slice().sort(function (x, y) { return y.amount - x.amount; }).map(function (i) { return itemRow(a, i); }).join('');
    return '<section class="acct">' +
      '<div class="acct-head"><div class="acct-title">' +
      '<h3 class="acct-name"><i style="background:var(--c' + (idx + 1) + ')"></i><span>' + esc(a.name) + '</span></h3>' +
      '<button class="link" data-act="rename" data-a="' + a.id + '">Adı değiştir</button></div>' +
      '<div class="acct-total"><span class="amt">' + money(itemSum(a)) + '</span>' +
      (pl ? '<span class="pl ' + (pl.pl >= 0 ? 'pos' : 'neg') + '">' + plText(pl.pl, pl.cost) + '</span>' : '') +
      '</div></div>' +
      '<div class="rows">' +
      (rows || '<p class="empty">Henüz kalem eklenmedi.</p>') +
      '</div>' +
      '<div class="acct-foot"><button class="btn ghost block" data-act="add-item" data-a="' + a.id + '">+ Kalem ekle</button></div>' +
      '</section>';
  }

  function viewInvest() {
    return '<p class="hint">Tutarları güncel portföyüne göre istediğin zaman yenileyebilirsin.</p>' +
      '<div class="grid">' + S.accounts.map(accountCard).join('') + '</div>';
  }

  function dueInfo(d) {
    if (!d.due || remaining(d) <= 0) return null;
    var n = dayDiff(d.due);
    if (n < 0) return { t: Math.abs(n) + ' gün gecikti', c: 'late' };
    if (n === 0) return { t: 'Bugün', c: 'late' };
    if (n <= 7) return { t: n + ' gün kaldı', c: 'soon' };
    return { t: fmtDate(d.due), c: '' };
  }

  function debtRow(d) {
    var rem = remaining(d), closed = rem <= 0, due = dueInfo(d);
    return '<button class="row" data-act="open-debt" data-d="' + d.id + '">' +
      '<span class="row-main"><span class="row-name">' + esc(d.person) + '</span>' +
      '<span class="row-meta"><span class="chip ' + d.dir + '">' + (d.dir === 'alacak' ? 'Alacak' : 'Verecek') + '</span>' +
      (closed ? '<span class="chip done">Kapandı</span>' : '') +
      (due ? '<span class="chip ' + due.c + '">' + due.t + '</span>' : '') +
      (d.note ? '<span class="note">· ' + esc(d.note) + '</span>' : '') + '</span></span>' +
      '<span class="row-val"><span class="amt ' + (d.dir === 'alacak' ? 'pos' : 'neg') + '">' + money(closed ? d.amount : rem) + '</span>' +
      '<span class="sub">' + (closed ? 'Tamamlandı' : (paidOf(d) > 0 ? money(d.amount) + ' içinden' : 'Bekliyor')) + '</span>' +
      '</span></button>';
  }

  function viewDebts() {
    var open = S.debts.filter(function (d) { return remaining(d) > 0; });
    var list = S.debts.filter(function (d) {
      var closed = remaining(d) <= 0;
      if (debtFilter === 'kapanan') return closed;
      if (closed) return false;
      return debtFilter === 'acik' ? true : d.dir === debtFilter;
    });
    var filters = [['acik', 'Açık'], ['alacak', 'Alacak'], ['verecek', 'Verecek'], ['kapanan', 'Kapanan']];

    return '<div class="sec-head"><h2>Kişi Borçları</h2><button class="btn primary sm" data-act="add-debt">+ Ekle</button></div>' +
      '<div class="chips">' + filters.map(function (f) {
        return '<button class="filter" data-act="filter" data-f="' + f[0] + '" aria-pressed="' + (debtFilter === f[0]) + '">' + f[1] + '</button>';
      }).join('') + '</div>' +
      '<div class="list-card">' + (list.length ? list.map(debtRow).join('') : '<p class="empty">Kayıt bulunamadı.</p>') + '</div>';
  }

  function stackBar(segs, total) {
    if (total <= 0) return '<p class="hint">Yatırım kaydı yok.</p>';
    var shown = segs.filter(function (s) { return s.value > 0; });
    return '<div class="stack">' + shown.map(function (s) {
      return '<span style="flex:' + s.value + ';background:' + s.color + '"></span>';
    }).join('') + '</div><ul class="legend">' + segs.map(function (s) {
      return '<li><i style="background:' + s.color + '"></i><span>' + esc(s.label) + '</span><span class="amt">' + money(s.value) + '</span><span class="pct">%' + (s.value / total * 100).toFixed(1).replace('.', ',') + '</span></li>';
    }).join('') + '</ul>';
  }

  function viewSplit() {
    var t = totals();
    var byAcct = S.accounts.map(function (a, i) { return { label: a.name, value: itemSum(a), color: 'var(--c' + (i + 1) + ')' }; });
    var byKind = KINDS.map(function (k, i) {
      var v = 0;
      S.accounts.forEach(function (a) { a.items.forEach(function (it) { if (it.kind === k[0]) v += it.amount; }); });
      return { label: k[1], value: v, color: 'var(--c' + (i + 1) + ')' };
    });
    return '<div class="panel"><h2 class="card-title">Hesaplara Göre</h2>' + stackBar(byAcct, t.invest) + '</div>' +
           '<div class="panel"><h2 class="card-title">Türe Göre</h2>' + stackBar(byKind, t.invest) + '</div>';
  }

  function render() {
    $('#hero').innerHTML = heroHtml();
    $('#banner').innerHTML = S.sample ? '<div class="banner"><span>Örnek veridesiniz.</span><button class="btn sm" data-act="sample-clear">Temizle</button></div>' : '';
    $('#tabs').innerHTML = TABS.map(function (t) {
      return '<button class="tab" role="tab" data-act="tab" data-t="' + t[0] + '" aria-selected="' + (tab === t[0]) + '">' + t[1] + '</button>';
    }).join('');
    $('#view').innerHTML = tab === 'alacak-verecek' ? viewDebts() : tab === 'dagilim' ? viewSplit() : viewInvest();
    var hb = $('#hide-btn');
    hb.innerHTML = HIDE ? ICON_EYE_OFF : ICON_EYE;
    hb.setAttribute('aria-pressed', String(HIDE));
  }

  /* Diyalog Yönetimi */
  var dlg = $('#dlg');
  function openDlg(html) {
    dlg.innerHTML = '<div class="sheet-handle"></div>' + html;
    if (!dlg.open) dlg.showModal();
  }

  function itemDialog(aid, iid) {
    var a = acct(aid);
    var it = iid ? a.items.filter(function (x) { return x.id === iid; })[0] : null;
    openDlg('<form class="sheet" data-form="item" data-a="' + aid + '" data-i="' + (it ? it.id : '') + '">' +
      '<h2>' + (it ? 'Düzenle' : 'Kalem Ekle') + '</h2>' +
      '<label>Ad<input type="text" name="name" placeholder="Örn. THYAO, Altın" value="' + esc(it ? it.name : '') + '" required></label>' +
      '<div class="two"><label>Tür<select name="kind">' + KINDS.map(function(k){ return '<option value="'+k[0]+'"'+(it && it.kind===k[0]?' selected':'')+'>'+k[1]+'</option>'; }).join('') + '</select></label>' +
      '<label>Tutar (₺)<input type="text" name="amount" inputmode="decimal" placeholder="0,00" value="' + (it ? toInput(it.amount) : '') + '" required></label></div>' +
      '<label>Maliyet (İsteğe bağlı)<input type="text" name="cost" inputmode="decimal" placeholder="Alış maliyeti" value="' + (it && it.cost ? toInput(it.cost) : '') + '"></label>' +
      '<label>Not<input type="text" name="note" placeholder="Ek notlar" value="' + esc(it ? it.note : '') + '"></label>' +
      '<p class="err" hidden></p>' +
      '<div class="actions">' +
      (it ? '<button type="button" class="btn danger" data-act="del-item" data-confirm data-a="' + aid + '" data-i="' + it.id + '">Sil</button>' : '') +
      '<span class="sp"></span><button type="button" class="btn ghost" data-act="close">Vazgeç</button><button type="submit" class="btn primary">Kaydet</button></div></form>');
  }

  function renameDialog(aid) {
    var a = acct(aid);
    openDlg('<form class="sheet" data-form="rename" data-a="' + aid + '">' +
      '<h2>Hesap Adını Değiştir</h2>' +
      '<label>Yeni Ad<input type="text" name="name" value="' + esc(a.name) + '" required></label>' +
      '<div class="actions"><span class="sp"></span><button type="button" class="btn ghost" data-act="close">Vazgeç</button><button type="submit" class="btn primary">Kaydet</button></div></form>');
  }

  function debtForm(id) {
    var d = id ? S.debts.filter(function (x) { return x.id === id; })[0] : null;
    openDlg('<form class="sheet" data-form="debt" data-d="' + (d ? d.id : '') + '">' +
      '<h2>' + (d ? 'Borç Düzenle' : 'Borç / Alacak Ekle') + '</h2>' +
      '<fieldset class="seg">' +
      '<label class="opt"><input type="radio" name="dir" value="alacak"' + (!d || d.dir === 'alacak' ? ' checked' : '') + '><span>Alacağım</span></label>' +
      '<label class="opt"><input type="radio" name="dir" value="verecek"' + (d && d.dir === 'verecek' ? ' checked' : '') + '><span>Vereceğim</span></label></fieldset>' +
      '<label>Kişi Adı<input type="text" name="person" placeholder="İsim" value="' + esc(d ? d.person : '') + '" required></label>' +
      '<div class="two"><label>Tutar (₺)<input type="text" name="amount" inputmode="decimal" placeholder="0,00" value="' + (d ? toInput(d.amount) : '') + '" required></label>' +
      '<label>Vade<input type="date" name="due" value="' + esc(d && d.due ? d.due : '') + '"></label></div>' +
      '<label>Not<input type="text" name="note" value="' + esc(d ? d.note : '') + '"></label>' +
      '<p class="err" hidden></p>' +
      '<div class="actions"><span class="sp"></span><button type="button" class="btn ghost" data-act="close">Vazgeç</button><button type="submit" class="btn primary">Kaydet</button></div></form>');
  }

  function debtDialog(id) {
    var d = S.debts.filter(function (x) { return x.id === id; })[0];
    if (!d) return dlg.close();
    var rem = remaining(d), paid = paidOf(d), rec = d.dir === 'alacak';
    var pct = d.amount > 0 ? Math.min(100, paid / d.amount * 100) : 0;
    openDlg('<div class="sheet">' +
      '<h2>' + esc(d.person) + '</h2>' +
      '<div class="stats"><div class="stat"><small>Toplam</small><b>' + money(d.amount) + '</b></div>' +
      '<div class="stat"><small>Ödenen</small><b>' + money(paid) + '</b></div>' +
      '<div class="stat"><small>Kalan</small><b class="' + (rec ? 'pos' : 'neg') + '">' + money(rem) + '</b></div></div>' +
      '<div class="prog"><i class="' + d.dir + '" style="width:' + pct + '%"></i></div>' +
      (rem > 0 ?
        '<form data-form="payment" data-d="' + d.id + '" style="display:grid;gap:10px;margin-top:6px">' +
        '<div class="two"><label>Ödeme Ekle (₺)<input type="text" name="amount" inputmode="decimal" value="' + toInput(rem) + '" required></label>' +
        '<label>Tarih<input type="date" name="date" value="' + today() + '"></label></div>' +
        '<button type="submit" class="btn primary block">Ödemeyi İşle</button></form>' : '<p class="hint">Bu borç tamamen kapatıldı.</p>') +
      '<div class="actions"><button type="button" class="btn danger" data-act="del-debt" data-confirm data-d="' + d.id + '">Sil</button><span class="sp"></span>' +
      '<button type="button" class="btn ghost" data-act="close">Kapat</button></div></div>');
  }

  function settingsDialog() {
    openDlg('<div class="sheet"><h2>Ayarlar ve Yedekleme</h2>' +
      '<p class="hint">Verileriniz bu cihazın yerel hafızasında saklanır. Telefon değiştirirken yedeğinizi kopyalayabilirsiniz.</p>' +
      '<button type="button" class="btn block" data-act="backup">Yedeği Panoya Kopyala</button>' +
      '<textarea id="backup-text" style="display:none"></textarea>' +
      '<p id="backup-msg" class="hint" style="display:none"></p>' +
      '<textarea id="restore-text" placeholder="Yedek kodunu buraya yapıştırın"></textarea>' +
      '<button type="button" class="btn block" data-act="restore" data-confirm>Yedeği Geri Yükle</button>' +
      '<button type="button" class="btn danger block" data-act="wipe" data-confirm>Tüm Verileri Sıfırla</button>' +
      '<div class="actions"><span class="sp"></span><button type="button" class="btn ghost" data-act="close">Kapat</button></div></div>');
  }

  var actions = {
    tab: function (b) { setTab(b.dataset.t); },
    filter: function (b) { debtFilter = b.dataset.f; render(); },
    'toggle-hide': function () {
      HIDE = !HIDE;
      try { localStorage.setItem(LS_HIDE, HIDE ? '1' : '0'); } catch (e) {}
      render();
    },
    settings: settingsDialog,
    close: function () { dlg.close(); },
    'add-item': function (b) { itemDialog(b.dataset.a, ''); },
    'edit-item': function (b) { itemDialog(b.dataset.a, b.dataset.i); },
    'del-item': function (b) {
      var a = acct(b.dataset.a);
      a.items = a.items.filter(function (x) { return x.id !== b.dataset.i; });
      dlg.close(); touch();
    },
    rename: function (b) { renameDialog(b.dataset.a); },
    'add-debt': function () { debtForm(''); },
    'open-debt': function (b) { debtDialog(b.dataset.d); },
    'del-debt': function (b) {
      S.debts = S.debts.filter(function (x) { return x.id !== b.dataset.d; });
      dlg.close(); touch();
    },
    wipe: function () { S = defaultState(); dlg.close(); touch(); },
    backup: function () {
      var txt = JSON.stringify(S);
      navigator.clipboard.writeText(txt).then(function() {
        $('#backup-msg').textContent = 'Yedek kopyalandı!';
        $('#backup-msg').style.display = 'block';
      });
    },
    restore: function () {
      try {
        var o = JSON.parse($('#restore-text').value.trim());
        S = normalize(o); dlg.close(); touch();
      } catch (e) { alert('Geçersiz yedek kodu!'); }
    }
  };

  document.addEventListener('click', function (e) {
    var b = e.target.closest('[data-act]');
    if (!b) return;
    if (b.hasAttribute('data-confirm') && !b.dataset.armed) {
      b.dataset.armed = '1';
      b.dataset.label = b.textContent;
      b.textContent = 'Tekrar dokunun';
      b.classList.add('armed');
