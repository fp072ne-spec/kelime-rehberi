    <div class="gt">📅 Son 7 Günlük Aktivite</div>
    <div class="qc">
      <div class="wk">
        ${days.map(x => `<div><i style="height:${Math.max(4, x.n / mx * 64)}px"></i>${x.l}<br>${x.n}</div>`).join('')}
      </div>
    </div>
  `;
}

function openSh(id) {
  const w = W.find(x => x.id === id); if (!w) return;
  const v = V(w), st = S.w[id] || [0, 0];
  $('sh').hidden = false;
  $('sh').innerHTML = `
    <div class="shc">
      <div class="sheet-bar"></div>
      <div class="l">${esc(w.gn)}</div>
      ${['en','es','tr'].map(c => `
        <div class="shr">
          <span class="l">${L[c].n}</span>
          <div class="qw">${esc(v[c][0])} <button class="sp" aria-label="Sesli Oku" data-t="${esc(v[c][0])}" data-c="${L[c].c}">🔊</button></div>
          <i style="font-style:normal;color:var(--mut)">${esc(v[c][1])}</i>
        </div>
      `).join('')}
      <div class="info" style="padding:4px 0 6px">Leitner Seviyesi: ${st[0]}/4 · Hata Sayısı: ${st[1]}</div>
      <div class="lv"><i style="width:${st[0] * 25}%"></i></div>
      <button class="pr" data-x style="width:100%;margin-top:16px">Tamam, Kapat</button>
    </div>
  `;
}

$('sh').onclick = e => { if (e.target.id === 'sh' || e.target.closest('[data-x]')) $('sh').hidden = true; };
$('nav').onclick = e => { const b = e.target.closest('button'); if (b) show(+b.dataset.v); };

document.addEventListener('click', e => {
  const go = e.target.closest('[data-go]');
  if (go) { show(+go.dataset.go); return; }

  const s = e.target.closest('.sp[data-t]');
  if (s) { say(s.dataset.t, s.dataset.c); return; }

  if (e.target.id === 'more') { LIM += 400; render(); return; }

  const mm = e.target.closest('[data-m]');
  if (mm) {
    const id = mm.dataset.m;
    S.mem[id] ? delete S.mem[id] : (S.mem[id] = 1);
    save();
    if (view === 0 && !$('hmem').checked) {
      mm.textContent = S.mem[id] ? '✅' : '⬜';
      mm.closest('.it').classList.toggle('mm', !!S.mem[id]);
    } else if (view === 0) render();
    else if (view === 3) mine();
    else if (view === 4) home();
    toast(S.mem[id] ? '✅ Ezberlenenlere eklendi' : 'Ezberlenenlerden çıkarıldı');
    return;
  }

  const f = e.target.closest('[data-f]');
  if (f) {
    const id = f.dataset.f;
    S.fav[id] ? delete S.fav[id] : (S.fav[id] = 1);
    save();
    if (view === 3) mine();
    else f.textContent = S.fav[id] ? '⭐' : '☆';
    return;
  }

  const it = e.target.closest('.it[data-id]');
  if (it && !e.target.closest('button')) openSh(it.dataset.id);
});

$('modes').onclick = e => {
  const b = e.target.closest('button');
  if (b) { S.m = +b.dataset.i; save(); render(); }
};

let tq;
const rr = () => { LIM = 400; render(); };
$('grp').onchange = $('pr').onchange = $('hmem').onchange = rr;
$('q').oninput = () => { clearTimeout(tq); tq = setTimeout(rr, 200); };

function applyTheme() {
  if (S.th) document.documentElement.dataset.theme = S.th;
  else delete document.documentElement.dataset.theme;
  $('th').checked = S.th ? S.th === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
}
$('th').onchange = e => { S.th = e.target.checked ? 'dark' : 'light'; save(); applyTheme(); };
$('rt').value = S.rate;
$('rt').onchange = e => { S.rate = +e.target.value; save(); };

$('ex').onclick = async () => {
  S.bk = Date.now(); save();
  const f = new File([JSON.stringify(S)], 'kelime-rehberi-yedek.json', { type: 'application/json' });
  try {
    if (navigator.canShare && navigator.canShare({ files: [f] })) {
      await navigator.share({ files: [f], title: 'Kelime Rehberi İlerleme Yedeği' });
      return;
    }
  } catch(e) { if (e.name === 'AbortError') return; }
  const a = document.createElement('a'); a.href = URL.createObjectURL(f); a.download = f.name; a.click();
};

$('im').onclick = () => $('fi').click();
$('fi').onchange = e => {
  const f = e.target.files[0]; if (!f) return;
  f.text().then(t => {
    try {
      S = { ...S, ...JSON.parse(t) };
      save(); toast('Yedek başarıyla içe aktarıldı');
      setTimeout(() => location.reload(), 600);
    } catch(x) { toast('Geçersiz yedek dosyası!'); }
  });
};

$('rs').onclick = () => {
  if (confirm('Tüm çalışma geçmişiniz ve favorileriniz sıfırlanacak. Emin misiniz?')) {
    S = { ...S, fav: {}, w: {}, day: {}, mem: {}, u: { d: '', a: [] } };
    save(); gprog(); mine(); toast('Veriler sıfırlandı');
  }
};

function buildG() {
  const opts = `<option value="-1">Tüm Konular ${S.sel.length ? `(${S.sel.length} seçili)` : ''}</option>` +
    D.map((g, i) => inSel(i) ? `<option value="${i}">${esc(g.n)} (${g.w.length})</option>` : '').join('');
  $('grp').innerHTML = opts;
  $('qg').innerHTML = opts;
  $('fcGroup').innerHTML = opts;
}

function gprog() {
  const n = uc(), g = S.goal || 20;
  $('gpb').style.width = Math.min(100, n / g * 100) + '%';
  $('gpt').textContent = n + '/' + g;
}

function obStart() {
  ob = { st: 0, dir: S.dir, sel: new Set(S.sel), goal: S.goal || 20 };
  obDraw();
}

function obDraw() {
  const o = $('ob'), s = ob.st; o.hidden = false;
  const P = [
    ['Merhaba! 👋', 'Hangi diller arasında çalışmak istersin?', QD.map((p, i) => `<button class="ch big${ob.dir === i ? ' on' : ''}" data-d="${i}">${L[p[0]].n} → ${L[p[1]].n}</button>`).join('')],
    ['Konu Tercihi 📚', 'Çalışmak istediğin konuları seçebilirsin. Hiçbirini seçmezsen tüm konular gelir.', '<div class="chs">' + D.map((g, i) => `<button class="ch${ob.sel.has(i) ? ' on' : ''}" data-s="${i}">${esc(g.n)}</button>`).join('') + '</div>'],
    ['Günlük Hedef 🎯', 'Günde kaç kelime veya cümle çalışmak istersin?', [10, 20, 30, 50].map(n => `<button class="ch big${ob.goal === n ? ' on' : ''}" data-g="${n}">${n} Kelime / Gün</button>`).join('')]
  ][s];

  o.innerHTML = `
    <div class="obc">
      <div class="dots">${[0, 1, 2].map(i => `<i class="${i <= s ? 'on' : ''}"></i>`).join('')}</div>
      <h2>${P[0]}</h2><p>${P[1]}</p>
      <div class="obb">${P[2]}</div>
      <div class="bt">
        ${s ? '<button class="pr sec" data-n="-1">Geri</button>' : '<button class="pr sec" data-sk>Atla</button>'}
        <button class="pr" data-n="1">${s === 2 ? 'Başla 🚀' : 'Devam'}</button>
      </div>
    </div>`;
}

$('ob').onclick = e => {
  const b = e.target.closest('button'); if (!b) return;
  const d = b.dataset;
  if (d.sk !== undefined) { S.ob = 1; save(); $('ob').hidden = true; return; }
  if (d.d !== undefined) ob.dir = +d.d;
  else if (d.s !== undefined) { const k = +d.s; ob.sel.has(k) ? ob.sel.delete(k) : ob.sel.add(k); }
  else if (d.g) ob.goal = +d.g;
  else if (d.n) {
    ob.st += +d.n;
    if (ob.st > 2) {
      S.dir = ob.dir; S.sel = [...ob.sel].sort((a,b)=>a-b);
      S.goal = ob.goal; S.m = DIRM[ob.dir]; S.ob = 1;
      save(); $('ob').hidden = true;
      buildG(); $('qd').value = S.dir; render(); gprog();
      toast('Tercihler kaydedildi! İyi çalışmalar 🎉');
      return;
    }
  }
  obDraw();
};

$('pf').onclick = obStart;

$('cwa').onclick = () => {
  const v = ['cwe', 'cwes', 'cwt'].map(i => $(i).value.trim());
  if (!v[0] || !v[2]) return toast('İngilizce ve Türkçe alanları zorunludur');
  const id = v[0] + '|' + v[2];
  if (W.some(w => w.id === id)) return toast('Bu kelime zaten mevcut');

  S.cw.push([v[0], '', v[1], '', v[2]]);
  if (!(D.length && D[D.length - 1].cust)) {
    D.push({ n: '✏️ Kendi Kelimelerim', w: S.cw, cust: 1 });
    if (S.sel.length) S.sel.push(D.length - 1);
  }
  W.push({ id, g: D.length - 1, gn: D[D.length - 1].n, en: v[0], enp: '', es: v[1], esp: '', tr: v[2] });
  save(); buildG(); render();
  ['cwe', 'cwes', 'cwt'].forEach(i => $(i).value = '');
  toast('Yeni kelime eklendi ✅');
};

function setFontSize(val) {
  S.fs = +val || 1; save();
  document.documentElement.style.setProperty('--fz-scale', S.fs);
  $('fz').value = S.fs;
}
$('fz').onchange = e => setFontSize(e.target.value);

addEventListener('popstate', e => {
  $('sh').hidden = true;
  show(e.state && e.state.v != null ? e.state.v : 4, 1);
});

try {
  if (S.cw && S.cw.length) {
    D.push({ n: '✏️ Kendi Kelimelerim', w: S.cw, cust: 1 });
    if (S.sel.length && !S.sel.includes(D.length - 1)) S.sel.push(D.length - 1);
  }

  D.forEach((gr, gi) => gr.w.forEach(r => {
    W.push({ id: r[0] + '|' + r[4], g: gi, gn: gr.n, en: r[0], enp: r[1], es: r[2], esp: r[3], tr: r[4] });
  }));

  $('modes').innerHTML = M.map((m, i) => `<button data-i="${i}">${m.map(x => L[x].s).join(' · ')}</button>`).join('');
  buildG();
  $('qd').innerHTML = QD.map((p, i) => `<option value="${i}">${L[p[0]].n} → ${L[p[1]].n}</option>`).join('');
  $('qd').value = S.dir;

  applyTheme();
  setFontSize(S.fs);
  render();
  gprog();

  if (!S.ob) obStart();
  show(location.hash === '#quiz' ? 2 : 4, 1);
} catch (err) {
  console.error(err);
  $('info').textContent = 'Yükleme hatası: ' + err.message;
}

if ('serviceWorker' in navigator && location.protocol.startsWith('http')) {
  navigator.serviceWorker.register('sw.js').catch(err => console.log('SW hatası:', err));
}
</script>
